# SciPulse Insights — modèle de configuration
# Copier ce fichier en .env puis renseigner les valeurs :
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (Mac / Linux)
# Le fichier .env n'est JAMAIS commité (il est dans .gitignore).

# Clé API OpenAlex gratuite (https://openalex.org) — uniquement pour réingérer les citations
OPENALEX_API_KEY=
OPENALEX_MAILTO=votre.email@exemple.com

# Dump ArXiv déposé dans MinIO par le DAG batch du module 1
ARXIV_RAW_PATH=s3a://arxiv-raw/arxiv-full-subset.json

# Optionnel : fraction du corpus pour le TF-IDF (1.0 = tout) et mémoire du driver Spark
TFIDF_SAMPLE=1.0
SPARK_DRIVER_MEMORY=4g
